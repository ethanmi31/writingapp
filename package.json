{
  "name": "inkwell",
  "version": "0.1.0",
  "private": true,
  "description": "Unrestricted front-end for OpenRouter models, built for long-form writing and roleplay: lorebooks, document memory, a live map and a scene simplifier.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js --dev",
